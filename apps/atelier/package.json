    "radix-vue": "^1.9.17",
    "vue": "^3.5.24",
    "@tanstack/vue-query": "^5.90.1",
    "@vueuse/core": "^14.0.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.2.0"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.10.1",
    "@veebox/volar": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "@vue/compiler-sfc": "^3.5.24",
    "@vue/test-utils": "^2.4.6",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.4",
    "jsdom": "^27.2.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "~5.9.0",
    "vitest": "^4.0.14",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^3.1.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
