{
  "name": "@vbox/atelier",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "webpack serve --config webpack.config.mjs --mode development",
    "build": "pnpm type-check && pnpm build-only",
