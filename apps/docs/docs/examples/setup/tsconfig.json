{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["*.ts", "*.vue", "theme/**/*.ts", "vbox.d.ts"],
  "vueCompilerOptions": {
    "plugins": [
      { "name": "@veebox/volar", "configPath": "./theme/vbox.config.ts" }
    ]
  }
}
