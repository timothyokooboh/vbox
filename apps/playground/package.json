{
  "name": "@vbox/playground",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*"
  },
  "dependencies": {
    "@polymorphic-factory/vue": "^0.2.1",
    "@veebox/core": "workspace:*",
    "@veebox/unplugin": "workspace:*",
    "@veebox/vue": "workspace:*",
    "vue": "^3.5.22",
    "@veebox/property-variance-authority": "workspace:*"
  },
  "devDependencies": {
    "@veebox/volar": "workspace:*",
    "@tsconfig/node22": "^22.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-oxlint": "~1.23.0",
    "eslint-plugin-vue": "~10.5.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "fs-extra": "^11.3.2",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.23.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.1"
  },
  "volta": {
    "node": "22.14.0"
  }
}
