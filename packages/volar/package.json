{
  "name": "@veebox/volar",
  "version": "0.1.0-beta.0",
  "description": "Vue language tooling for VBox style completions, diagnostics and token previews.",
  "keywords": [
    "vue",
    "volar",
    "vbox",
    "design-tokens",
    "hover"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timothyokooboh/vbox.git",
    "directory": "packages/volar"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "node ./scripts/build.mjs",
    "lint": "echo \"No lint script yet\"",
    "test": "pnpm build && node --test tests/**/*.test.cjs"
  },
  "dependencies": {
    "@veebox/core": "workspace:*",
    "entities": "^7.0.1",
    "jiti": "^2.6.1",
    "known-css-properties": "^0.37.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@vue/compiler-dom": "^3.5.24"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
